{
  "schema_version": 1,
  "reviewed_at": "2026-10-12",
  "usage": "先独立看图构思，再检索少量机制候选；按 motion-design.md 调整主次、速度、轨迹、跟随/环境响应与收束。内容锚点与允许运动分开；用户指定匀速等优先。允许库外组合，传统参考不等于即梦实测。",
  "sources": {
    "eyecandy": "https://eyecannndy.com/",
    "som-transitions": "https://schoolofmotion.com/blog/six-essential-motion-design-transitions-tutorial",
    "shiritori": "https://www.stashmedia.tv/transitional-flow-watch-hitoshi-moritas-mesmerizing-new-short-film-shiritori/",
    "titles": "https://www.artofthetitle.com/",
    "flora-design": "https://flora.ai/techniques/frame-the-mood-for-creatives",
    "flora-loop": "https://flora.ai/techniques/dreamscape"
  },
  "entries": [
    {
      "id": "route-response",
      "family": "片内动效",
      "name": "已有路径传递与节点响应",
      "evidence": "design_hypothesis",
      "mechanism": "能量/高光沿已明确的路径移动；到达可动节点触发局部材质或光影反馈，末段收束。",
      "fits": [
        "可见连线与方向",
        "实际节点构成通路",
        "需要表达连接或传递"
      ],
      "reject_if": [
        "流向或业务关系不明确却要求按编号推断",
        "线路不存在",
        "每段都用光流而无表达理由"
      ],
      "anchors": [
        "连接拓扑",
        "节点数量",
        "方向",
        "文案与数字"
      ],
      "variables": [
        "脉冲长度",
        "传播是否同时或接力",
        "局部响应",
        "连续速度",
        "收束位置"
      ],
      "risk": "细连线可能重绘断裂；只在现有路径承载，避免模型发明连接。",
      "source_ids": [
        "flora-design"
      ]
    },
    {
      "id": "surface-wave",
      "family": "片内动效",
      "name": "表面波动与材质响应",
      "evidence": "design_hypothesis",
      "mechanism": "连续波或压力在已有无字表面传播，表面高光、反射或浅浮雕同步响应；信息层保持。",
      "fits": [
        "面积足够的空白表面",
        "材质有反射或层次",
        "布局应固定但效果需明显"
      ],
      "reject_if": [
        "整片表面都被文字覆盖",
        "波动必须扭曲准确数据",
        "凭空添加承载面"
      ],
      "anchors": [
        "文字层",
        "信息面板位置",
        "边界与数量"
      ],
      "variables": [
        "波前形状",
        "表面位置",
        "高光宽度",
        "反射强度",
        "传播方向"
      ],
      "risk": "模型可能连同卡片一起扭曲；明确表面效果与文字层分工。",
      "source_ids": [
        "eyecandy"
      ]
    },
    {
      "id": "articulated-unfold",
      "family": "片内动效",
      "name": "沿既有结构展开",
      "evidence": "design_hypothesis",
      "mechanism": "已有可分部件围绕可见接点展开，层间光线与阴影响应，形成整体展示状态。",
      "fits": [
        "有可见分层或接点",
        "主体结构允许变化",
        "需要揭示内部或协同关系"
      ],
      "reject_if": [
        "卡片必须原位且全部文字持续可读",
        "不存在可分部件",
        "要求凭空重建复杂装置"
      ],
      "anchors": [
        "部件身份与数量",
        "最终展示关系",
        "不可动的文字区域"
      ],
      "variables": [
        "展开轴",
        "先后",
        "展开幅度",
        "层间光影",
        "末段状态"
      ],
      "risk": "结构复杂时可能增减部件；优先明确少量可动对象。",
      "source_ids": [
        "eyecandy"
      ]
    },
    {
      "id": "orbit-response",
      "family": "片内动效",
      "name": "沿现有环形结构运动",
      "evidence": "design_hypothesis",
      "mechanism": "允许的载体沿已有环形结构绕行，近远明暗或拖尾体现轨迹；中心与信息锚点保持。",
      "fits": [
        "可见环或弧线",
        "中心主体与外围结构",
        "需要协同/循环的视觉表达"
      ],
      "reject_if": [
        "没有环形依据",
        "外围文字模块必须固定却被整体旋转",
        "已有连续同套路片段"
      ],
      "anchors": [
        "环的透视",
        "中心主体",
        "固定模块和文字"
      ],
      "variables": [
        "载体是光还是可动实体",
        "速度曲线",
        "近远强度",
        "局部响应",
        "收束位置"
      ],
      "risk": "旋转容易带动全部模块；把轨道效果与模块运动拆开写。",
      "source_ids": [
        "eyecandy"
      ]
    },
    {
      "id": "material-phase",
      "family": "片内动效",
      "name": "材质阶段变化",
      "evidence": "design_hypothesis",
      "mechanism": "主体轮廓保持，指定表面发生由一种状态到另一种状态的变化，高光与环境响应随之变化。",
      "fits": [
        "材料是视觉重点",
        "主体轮廓清晰",
        "用户许可材质变化"
      ],
      "reject_if": [
        "品牌材质不可更改",
        "精确文字要被熔化或结晶",
        "变化产生新的业务含义"
      ],
      "anchors": [
        "轮廓",
        "数量",
        "版式",
        "最终材质要求"
      ],
      "variables": [
        "起止材质",
        "变化边界",
        "方向",
        "明暗响应",
        "回到母版或留在尾态"
      ],
      "risk": "材质变化可牵动身份或字形；优先局部表面。",
      "source_ids": [
        "eyecandy",
        "titles"
      ]
    },
    {
      "id": "occlusion-reveal",
      "family": "片内动效/衔接",
      "name": "既有遮挡触发展示",
      "evidence": "principle_reference",
      "mechanism": "已存在的允许运动物体、面或光影经过画面，用遮挡与释放形成信息揭示或两状态衔接。",
      "fits": [
        "图中有可作遮挡的前景或平面",
        "已有显隐变化",
        "允许信息短暂被遮挡"
      ],
      "reject_if": [
        "全程文字不可遮挡",
        "无合理遮挡来源",
        "强行加巨大色块盖住内容"
      ],
      "anchors": [
        "遮挡前后内容身份",
        "阅读终态",
        "空间层级"
      ],
      "variables": [
        "遮挡载体",
        "方向",
        "速度",
        "遮挡比例",
        "释放顺序"
      ],
      "risk": "遮挡后可能重绘内容；恢复到明确参考终态并验收。",
      "source_ids": [
        "som-transitions"
      ]
    },
    {
      "id": "depth-reveal",
      "family": "镜头/片内动效",
      "name": "层次揭示与视差",
      "evidence": "principle_reference",
      "mechanism": "适度镜头或允许图层相对位移揭示近远关系，前中后景速度与光影不同，最终形成稳定展示。",
      "fits": [
        "实际有前中后层",
        "空间层次能解释内容",
        "用户许可相对位移或镜头"
      ],
      "reject_if": [
        "扁平信息布局不许移动",
        "假造多层业务含义",
        "没有足够边界空间"
      ],
      "anchors": [
        "主体身份",
        "层次关系",
        "最终阅读构图"
      ],
      "variables": [
        "方向",
        "各层位移差",
        "视角幅度",
        "光影响应",
        "回到原位或停留新状态"
      ],
      "risk": "未提供空间内容可能被外推；镜头应依已有深度限定。",
      "source_ids": [
        "eyecandy"
      ]
    },
    {
      "id": "shape-match",
      "family": "帧间衔接",
      "name": "形状与构图匹配衔接",
      "evidence": "principle_reference",
      "mechanism": "利用两帧实际共有的轮廓、位置、面积或方向，在动作峰值衔接，不要求实体变成新业务对象。",
      "fits": [
        "两帧存在可识别视觉匹配",
        "允许剪辑或生成过渡",
        "衔接需要清楚而快速"
      ],
      "reject_if": [
        "只有一张图却假造下一场景",
        "只是同配色无结构匹配",
        "匹配误导业务关系"
      ],
      "anchors": [
        "对应对象",
        "匹配位置",
        "两帧最终设计"
      ],
      "variables": [
        "匹配载体",
        "动作峰值",
        "切换时机",
        "运动延续",
        "短暂过渡或直接切"
      ],
      "risk": "AI 可能强行变形；直接剪辑是该原理的一种选择，不默认生成复杂 morph。",
      "source_ids": [
        "som-transitions"
      ]
    },
    {
      "id": "portal-pass",
      "family": "镜头/帧间衔接",
      "name": "穿越既有窗口或空间入口",
      "evidence": "principle_reference",
      "mechanism": "镜头经过已存在的框、窗口或空间开口，进入已提供/许可的下一状态。",
      "fits": [
        "存在嵌套框架或真实开口",
        "下一场景已给定",
        "镜头穿越是表达需要"
      ],
      "reject_if": [
        "精确文字被强制放大变形",
        "下一场景无依据",
        "项目已连续推进穿越"
      ],
      "anchors": [
        "入口与出口对应",
        "前后状态",
        "重要文字的最终可读状态"
      ],
      "variables": [
        "穿越方向",
        "加减速",
        "入口尺度",
        "遮挡",
        "最终景别"
      ],
      "risk": "外推内容和透视容易漂移；不默认全片一镜到底。",
      "source_ids": [
        "som-transitions",
        "eyecandy"
      ]
    },
    {
      "id": "topology-morph",
      "family": "帧间衔接",
      "name": "可对应轮廓连续变换",
      "evidence": "principle_reference",
      "mechanism": "两张明确状态之间，允许变化的轮廓或无字主体连续变换；事实层不参与熔化。",
      "fits": [
        "用户提供前后状态",
        "对象身份或形状对应明确",
        "用户许可变形"
      ],
      "reject_if": [
        "精确文字/Logo 不许变化",
        "对象数量不匹配且无明确增减要求",
        "只为酷而改变图示含义"
      ],
      "anchors": [
        "明确起止状态",
        "不变事实",
        "数量要求"
      ],
      "variables": [
        "形变路径",
        "中段速度",
        "遮挡配合",
        "表面响应",
        "末段保持"
      ],
      "risk": "复杂汉字和标志高风险；传统成功案例不是即梦可保真证据。",
      "source_ids": [
        "som-transitions"
      ]
    },
    {
      "id": "title-environment",
      "family": "标题动效",
      "name": "标题触发环境响应",
      "evidence": "design_hypothesis",
      "mechanism": "标题轮廓/阅读区稳定，已有或许可的环境光、粒子、反射对其产生聚焦响应，效果与标题材质结合。",
      "fits": [
        "标题为主要视觉",
        "周围有留白与效果承载",
        "用户许可标题参与生成"
      ],
      "reject_if": [
        "全文密集无空间",
        "不得任何字形变化却要求粒子解体",
        "环境效果盖住字"
      ],
      "anchors": [
        "准确文案",
        "标题轮廓与位置",
        "可读终态"
      ],
      "variables": [
        "触发位置",
        "环境响应",
        "光向",
        "粒子轨迹",
        "高潮持续"
      ],
      "risk": "效果依附字形时修字成本高；沿用用户文字路线并真实验收。",
      "source_ids": [
        "titles"
      ]
    },
    {
      "id": "environment-loop",
      "family": "氛围/循环",
      "name": "环境持续运动与稳定阅读",
      "evidence": "workflow_reference",
      "mechanism": "已有环境中的雾、光、反射或允许载体持续运动，主体与信息稳定；循环另行检查首尾接缝。",
      "fits": [
        "氛围背景",
        "现场阅读需要停留",
        "存在环境承载"
      ],
      "reject_if": [
        "需要主动作高潮却只给微光",
        "没有环境运动依据",
        "承诺模型必然无缝"
      ],
      "anchors": [
        "信息区域",
        "主体构图",
        "循环身份与光照连续"
      ],
      "variables": [
        "环境对象",
        "周期",
        "局部范围",
        "强度",
        "首尾匹配"
      ],
      "risk": "生成循环可能跳变；相同首尾图不保证无缝。",
      "source_ids": [
        "flora-loop"
      ]
    },
    {
      "id": "assembly-reveal",
      "family": "片内动效",
      "name": "已有部件定向组装",
      "evidence": "design_hypothesis",
      "mechanism": "已提供起始/结束状态或明确许可的部件按可见接口组装，接触时光影/材质反馈强化完成感。",
      "fits": [
        "有部件和接口",
        "组装关系已知",
        "用户允许起始状态变化"
      ],
      "reject_if": [
        "单张完整图且不允许拆解",
        "需要新造关键帧才能成立",
        "未指定新部件"
      ],
      "anchors": [
        "部件数量",
        "接口",
        "最终结构",
        "文字"
      ],
      "variables": [
        "进入方向",
        "接触反馈",
        "顺序",
        "速度",
        "末段展示"
      ],
      "risk": "缺参考易增减部件；已有素材不足就选其他可行机制，不强制补帧。",
      "source_ids": [
        "eyecandy"
      ]
    },
    {
      "id": "focus-travel",
      "family": "镜头/注意力",
      "name": "已有空间中焦点迁移",
      "evidence": "principle_reference",
      "mechanism": "注意从一个真实深度层移动到另一个，焦点、局部照明与主体动作配合，最终重点清楚。",
      "fits": [
        "有明确深度",
        "两个重点需要先后阅读",
        "允许景深变化"
      ],
      "reject_if": [
        "精确正文必须全程清晰",
        "扁平信息图",
        "仅换聚焦区域伪装新的机制"
      ],
      "anchors": [
        "信息身份",
        "层次",
        "最终重点"
      ],
      "variables": [
        "先后焦点",
        "迁移时机",
        "光影配合",
        "景深幅度",
        "停留"
      ],
      "risk": "虚焦可能影响阅读；高密度文字优先排除。",
      "source_ids": [
        "eyecandy"
      ]
    }
  ],
  "design_reference": "motion-design.md"
}
